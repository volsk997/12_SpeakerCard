type: custom:bubble-card
card_type: pop-up
hash: "#edifier"
margin_top_mobile: auto
margin_top_desktop: auto
show_header: false
close_by_clicking_outside: false
backdrop_blur: "5"
bg_blur: "100"
bg_opacity: "50"
button_type: name
styles: |
  #root {
    border: 1px solid rgba(var(--rgb-primary-text-color),0.1);
    background: rgba(255, 255, 255, 0.1);
    }
sub_button:
  main: []
  bottom: []
cards:
  - type: custom:mushroom-chips-card
    chips:
      - type: template
        content: Акустика
        double_tap_action:
          action: none
        tap_action:
          action: none
        hold_action:
          action: none
        icon: mdi:speaker
      - type: spacer
      - type: back
        card_mod:
          style:
            .: |
              {% set hover = 'true' %}
              {% set stating = 'false' %}
              {% include 'chip_settings_style.jinja' %}
    card_mod:
      style:
        mushroom-back-chip:nth-child(3)$: |
          ha-state-icon {
            --card-mod-icon: mdi:close;
          }
        .: |
          {% include 'pop_up_title.jinja' %}
    grid_options:
      columns: 12
      rows: auto
  - type: custom:mushroom-chips-card
    chips:
      - type: template
        entity: input_boolean.akustika
        tap_action:
          action: toggle
        hold_action:
          action: none
        double_tap_action:
          action: none
        icon: mdi:power
        icon_color: |2-
            {% if is_state(entity, 'on')%} black
            {% else %} 1
            {% endif %}
        card_mod:
          style:
            .: |
              {% set scale = '1' %}
              {% set hover = 'true' %}
              {% set stating = 'true' %}
              {% set state_on = 'on' %}
              {% set color = 'rgba(120,120,120,0.2)' %}
              {% set hover_color_off = 'rgba(120,120,120,0.3) !important' %}
              {% include 'chip_settings_style.jinja' %}
    alignment: center
    card_mod:
      style:
        .: |
          ha-card {
             --chip-background: none !important;
             --chip-border-radius: 1000px;
             zoom: 6;
             #--chip-height: 200px;
             --chip-spacing: {{chip_spacing|default(0)}}px;
             margin: 2px;
             }
  - type: custom:horizontal-stack-in-card
    cards:
      - type: custom:mushroom-template-card
        features_position: bottom
        entity: input_select.r1280db_source
        grid_options:
          columns: 12
          rows: auto
        color: |-
          {% if is_state(config.entity, 'M-Audio')%} white
          {% else %} disabled
          {% endif %}
        tap_action:
          action: perform-action
          perform_action: script.turn_on
          target:
            entity_id: script.edifier
          data:
            variables:
              command: line_1
        icon: mdi:audio-input-rca
        vertical: true
        icon_tap_action:
          action: none
        card_mod:
          style: |
            ha-card {
              zoom: 1.5;
              background: none;
            }
      - type: custom:mushroom-template-card
        features_position: bottom
        entity: input_select.r1280db_source
        grid_options:
          columns: 12
          rows: auto
        color: |-
          {% if is_state(config.entity, 'PC')%} white
          {% else %} disabled
          {% endif %}
        tap_action:
          action: perform-action
          perform_action: script.turn_on
          target:
            entity_id: script.edifier
          data:
            variables:
              command: line_2
        icon: fas:computer
        vertical: true
        icon_tap_action:
          action: none
        card_mod:
          style: |
            ha-card {
              zoom: 1.5;
              background: none;
            }
      - type: custom:mushroom-template-card
        features_position: bottom
        entity: input_select.r1280db_source
        grid_options:
          columns: 12
          rows: auto
        color: |-
          {% if is_state(config.entity, 'Bluetooth')%} white
          {% else %} disabled
          {% endif %}
        tap_action:
          action: perform-action
          perform_action: script.turn_on
          target:
            entity_id: script.edifier
          data:
            variables:
              command: bt
        icon: mdi:bluetooth
        vertical: true
        icon_tap_action:
          action: none
        card_mod:
          style: |
            ha-card {
              zoom: 1.5;
              background: none;
            }
    card_mod:
      style: |
        ha-card {
         background: none !important;
        }
popup_mode: default
card_layout: large
slide_to_close_distance: "500"
